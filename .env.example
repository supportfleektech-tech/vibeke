# Database - local kinara_db, production set to Neon/Supabase/Vercel Postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/kinara_db

# Auth - REQUIRED in production, min 32 chars, generate with: openssl rand -base64 48
# Left empty on purpose: the server derives a throwaway dev key when unset, and
# refuses to boot in production. Never commit a real secret here.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AI - OpenRouter (preferred, supports OpenAI + OSS) or OpenAI direct
# Get free key at https://openrouter.ai/keys (zero budget: use free models like meta-llama/llama-3.1-8b:free)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
# Fallback model for zero-budget: openai/gpt-4o-mini or meta-llama/llama-3.1-8b:free

# Rate-limit - optional Upstash Redis; in-memory fallback if empty
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Monitoring
SENTRY_DSN=

# Seed protection - REQUIRED in production to protect POST /api/seed
# Generate with: openssl rand -hex 24
SEED_SECRET=

# Seeded demo accounts (brianmwangi, folake, amina, etc.) all share this password.
# Min 8 chars. Unset -> accounts are seeded with no credential and cannot log in.
SEED_PASSWORD=

# Maps - Leaflet/OSM needs no key; optional Mapbox for nicer tiles
NEXT_PUBLIC_MAPBOX_TOKEN=

# Node
NODE_ENV=development
